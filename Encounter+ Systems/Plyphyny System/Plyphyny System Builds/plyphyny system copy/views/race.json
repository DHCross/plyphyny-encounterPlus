{
  "debug": false,
  "spacing": 8,
  "padding": [16],
  "views": [
    {
      "type": "statBlock",
      "spacing": 8,
      "padding": [16],
      "views": [
        {
          "type": "hStack",
          "alignment": "center",
          "spacing": 12,
          "views": [
            {
              "type": "image",
              "value": "{{image}}",
              "width": 64,
              "height": 64,
              "cornerRadius": 8,
              "imageResizeMode": "aspectFill",
              "link": "{{image}}"
            },
            {
              "type": "vStack",
              "spacing": 2,
              "width": 0,
              "views": [
                {
                  "style": "title",
                  "value": "{{name}}"
                },
                {
                  "style": "subtitle",
                  "value": "*Playable Race*"
                }
              ]
            }
          ]
        },
        {
          "type": "divider",
          "style": "triangle",
          "height": 5,
          "padding": [0]
        },
        {
          "type": "text",
          "value": "{{descr}}"
        },
        {
          "type": "text",
          "value": "{{description}}"
        },
        {
          "type": "text",
          "value": "{% if data.traits %}### Racial Traits\n{{data.traits}}{% endif %}"
        },
        {
          "type": "text",
          "value": "{% if data.abilities %}### Abilities\n{{data.abilities}}{% endif %}"
        },
        {
          "type": "image",
          "value": "{{image}}",
          "link": "{{image}}"
        },
        {
          "type": "tags",
          "attribute": "tags"
        }
      ]
    }
  ]
}
