{
  "debug": false,
  "spacing": 8,
  "padding": [16],
  "views": [
    {
      "type": "statBlock",
      "spacing": 8,
      "padding": [16],
      "views": [
        {
          "type": "hStack",
          "spacing": 12,
          "alignment": "center",
          "views": [
            {
              "type": "image",
              "value": "{{image}}",
              "width": 60,
              "height": 60,
              "cornerRadius": 8,
              "imageResizeMode": "aspectFill",
              "link": "{{image}}"
            },
            {
              "type": "vStack",
              "spacing": -1,
              "width": 0,
              "views": [
                {
                  "style": "title",
                  "value": "{{name}}"
                },
                {
                  "style": "subtitle",
                  "value": "*Level {{level|default: 0}} {{school|default: 'Arcane'}} Spell*"
                }
              ]
            }
          ]
        },
        {
          "type": "divider",
          "style": "triangle",
          "height": 5,
          "padding": [0]
        },
        {
          "type": "text",
          "style": "stats-body",
          "value": "{% if data.castingTime %}**Casting Time:** {{data.castingTime}}\n{% endif %}{% if data.range %}**Range:** {{data.range}}\n{% endif %}{% if data.components %}**Components:** {{data.components}}\n{% endif %}{% if data.duration %}**Duration:** {{data.duration}}{% endif %}"
        },
        {
          "type": "divider",
          "style": "triangle",
          "height": 5,
          "padding": [0]
        },
        {
          "type": "text",
          "value": "{{descr}}"
        },
        {
          "type": "text",
          "value": "{{description}}"
        },
        {
          "type": "text",
          "title": "Notes",
          "value": "{{notes}}"
        },
        {
          "type": "image",
          "value": "{{image}}",
          "link": "{{image}}"
        },
        {
          "type": "tags",
          "attribute": "tags"
        }
      ]
    }
  ]
}
