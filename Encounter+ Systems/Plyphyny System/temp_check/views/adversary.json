{
  "debug": false,
  "spacing": 8,
  "padding": [16],
  "views": [
    {
      "type": "statBlock",
      "spacing": 8,
      "padding": [16],
      "views": [
        {
          "type": "vStack",
          "spacing": 0,
          "views": [
            {
              "style": "title",
              "value": "{{name}}"
            },
            {
              "style": "subtitle",
              "value": "*{{data.Opponent_type|default: 'Adversary'}} - Phase {{data.battlephase|default: '-'}} / Save {{data.save|default: '-'}}*"
            }
          ]
        },
        {
          "type": "divider",
          "style": "triangle",
          "height": 5,
          "padding": [0]
        },
        {
          "type": "text",
          "style": "stats-body",
          "value": "**Armor:** {{data.armor|default: 'Natural Hide'}}"
        },
        {
          "type": "divider",
          "style": "triangle",
          "height": 5,
          "padding": [0]
        },
        {
          "type": "hStack",
          "spacing": 1,
          "views": [
            {
              "value": "**ADP**\n{{data.hpActive|default: 0}}",
              "style": "stats-ability"
            },
            {
              "value": "**PDP**\n{{data.hpPassive|default: 0}}",
              "style": "stats-ability"
            },
            {
              "value": "**HP**\n{{data.hp|default: 0}}",
              "style": "stats-ability"
            },
            {
              "value": "**Spirit**\n{{data.sp_current|default: 0}}",
              "style": "stats-ability"
            },
            {
              "value": "**Init**\n{{data.battlephase|default: '-'}}",
              "style": "stats-ability"
            }
          ]
        },
        {
          "type": "divider",
          "style": "triangle",
          "height": 5,
          "padding": [0]
        },
        {
          "type": "text",
          "style": "stats-body",
          "value": "**Melee:** {{data.melee_attack|default: '-'}}\n\n**Ranged:** {{data.ranged_attack|default: '-'}}\n\n**Magic:** {{data.magic_attack|default: '-'}}"
        },
        {
          "type": "divider",
          "style": "triangle",
          "height": 5,
          "padding": [0]
        },
        {
          "type": "text",
          "style": "stats-body",
          "value": "{{data.descr|default: 'No description available.'}}"
        }
      ]
    }
  ]
}
